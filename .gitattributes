* text=auto

*.md text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.mjs text eol=lf
# Vendored npm CLI entrypoints keep LF under Windows checkout and npm bin linking.
vendor/desktop-commander/dist/*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.editorconfig text eol=lf
.github/CODEOWNERS text eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf

*.exe binary
*.dll binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.spdx.json text eol=lf

# npm bin-links can normalize shebangs on Windows CI; pin stable LF bytes.
vendor/desktop-commander/dist/index.js text eol=lf
vendor/desktop-commander/dist/setup-claude-server.js text eol=lf
vendor/desktop-commander/dist/uninstall-claude-server.js text eol=lf
