<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMCP Control" Width="420" Height="560"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text">
  <Window.Resources>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF2DE0D8" Offset="0"/>
      <GradientStop Color="#FF22B8FF" Offset="0.48"/>
      <GradientStop Color="#FF2563EB" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrandCyan" Color="#FF2DE0D8"/>
    <SolidColorBrush x:Key="BrandBlue" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="UiTextPrimary" Color="#FF18181B"/>
    <SolidColorBrush x:Key="UiTextSecondary" Color="#FF71717A"/>
    <SolidColorBrush x:Key="UiTextMuted" Color="#FF8E8E93"/>
    <SolidColorBrush x:Key="UiSurface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="UiSurfaceMuted" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="UiInputSurface" Color="#FFF3F3F5"/>
    <SolidColorBrush x:Key="UiInputBorder" Color="#12000000"/>
    <SolidColorBrush x:Key="UiBorder" Color="#18000000"/>
    <SolidColorBrush x:Key="UiAccentSoft" Color="#FFE9F8FA"/>
    <SolidColorBrush x:Key="UiAccentText" Color="#FF087E8A"/>
    <SolidColorBrush x:Key="UiDangerSoft" Color="#FFFFF0F0"/>
    <SolidColorBrush x:Key="UiDangerText" Color="#FFD92D20"/>

    <Style x:Key="RoundedTextBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource UiTextPrimary}"/>
      <Setter Property="Background" Value="{DynamicResource UiInputSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiInputBorder}"/>
      <Setter Property="CaretBrush" Value="{StaticResource BrandBlue}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource BrandBlue}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
      <Setter Property="Foreground" Value="{DynamicResource UiTextPrimary}"/><Setter Property="Background" Value="{DynamicResource UiInputSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource UiInputBorder}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource BrandBlue}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SegmentButton" TargetType="Button">
      <Setter Property="Foreground" Value="#71717A"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="13" Padding="8,9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource BrandGradient}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ActionBg" Background="{TemplateBinding Background}" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="18" Padding="16,13">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ActionBg" Property="Opacity" Value="0.94"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ActionBg" Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MiniButton" TargetType="Button">
      <Setter Property="Foreground" Value="#27272A"/>
      <Setter Property="Background" Value="#F2F2F4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="MiniBg" Background="{TemplateBinding Background}" BorderBrush="#08000000" BorderThickness="1" CornerRadius="14" Padding="11,9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MiniBg" Property="Opacity" Value="0.92"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="MiniBg" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="RootCard" Margin="14" CornerRadius="30" BorderBrush="#10000000" BorderThickness="1" Padding="16" Background="#FFFFFFFF">
    <Border.Effect>
      <DropShadowEffect Color="#3D000000" BlurRadius="36" ShadowDepth="9" Opacity="0.20"/>
    </Border.Effect>
    <Border.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" CenterX="196" CenterY="336"/>
        <TranslateTransform x:Name="PanelTranslate" Y="0"/>
      </TransformGroup>
    </Border.RenderTransform>
    <Grid>
      <Grid x:Name="MainPage" Opacity="1">
        <Grid.RenderTransform><TranslateTransform X="0"/></Grid.RenderTransform>
        <Grid.RowDefinitions>
        <RowDefinition Height="158"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border x:Name="HeroCard" Grid.Row="0" CornerRadius="24" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="18">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF111113" Offset="0"/>
            <GradientStop Color="#FF18181B" Offset="0.62"/>
            <GradientStop Color="#FF202024" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="BrandMark" Grid.Column="0" Source="pack://application:,,,/brand/deskmcp-mark-64.png" Width="42" Height="42" Stretch="Uniform" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="DeskMCP" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="Your desktop. Connected to AI." Foreground="#A1A1AA" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="3" x:Name="LivePill" Background="#FF214A30" BorderBrush="#FF2B5C3C" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#34C759" Margin="0,0,6,0"/>
                <TextBlock x:Name="LiveText" Text="Live" Foreground="#D9FFE3" FontSize="11" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border Grid.Row="1" Height="12"/>
<Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="GatewayCard" Grid.Column="0" Background="#FF2A2A2E" BorderBrush="#FF3A3A3F" BorderThickness="1" CornerRadius="15" Padding="11,9">
              <StackPanel>
                <TextBlock Text="Gateway" Foreground="#A1A1AA" FontSize="10"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Ellipse x:Name="GatewayDot" Width="7" Height="7" Fill="#8E8E93" Margin="0,0,6,0"/>
                  <TextBlock x:Name="GatewayStatus" Text="Checking" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="TunnelCard" Grid.Column="2" Background="#FF2A2A2E" BorderBrush="#FF3A3A3F" BorderThickness="1" CornerRadius="15" Padding="11,9">
              <StackPanel>
                <TextBlock Text="Tunnel" Foreground="#A1A1AA" FontSize="10"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Ellipse x:Name="TunnelDot" Width="7" Height="7" Fill="#8E8E93" Margin="0,0,6,0"/>
                  <TextBlock x:Name="TunnelStatus" Text="Checking" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="2,16,2,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="ProfileSectionTitle" Text="Permission profile" Foreground="#18181B" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock x:Name="ProfileHint" Text="Local permission boundary" Foreground="#8E8E93" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="ProfileBadge" Text="READ" Foreground="#71717A" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
      </Grid>
      <Border x:Name="ProfileShell" Grid.Row="2" Margin="0,10,0,0" Background="#E7E7EC" BorderBrush="#0A000000" BorderThickness="1" CornerRadius="16" Padding="4">
        <Grid x:Name="ProfileSegmentsGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="ProfileIndicator" Grid.ColumnSpan="3" HorizontalAlignment="Left"
                  Background="#FFFFFFFF" BorderBrush="#10000000" BorderThickness="1" CornerRadius="13" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect Color="#44000000" BlurRadius="14" ShadowDepth="1" Opacity="0.18"/></Border.Effect>
            <Border.RenderTransform><TranslateTransform x:Name="ProfileIndicatorTransform" X="0"/></Border.RenderTransform>
          </Border>
          <Button Grid.Column="0" x:Name="ReadButton" Style="{StaticResource SegmentButton}" Content="Read"/>
          <Button Grid.Column="1" x:Name="WriteButton" Style="{StaticResource SegmentButton}" Content="Write"/>
          <Button Grid.Column="2" x:Name="FullButton" Style="{StaticResource SegmentButton}" Content="Full"/>
        </Grid>
      </Border>
      <Border x:Name="ScopeCard" Grid.Row="3" Margin="0,14,0,0" Background="#FFFEFEFF" BorderBrush="#0B000000" BorderThickness="1" CornerRadius="20" Padding="15">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="ScopeLabel" Text="Scope" Foreground="#8E8E93" FontSize="10"/>
              <TextBlock x:Name="ScopeText" Text="Checking&#x2026;" Foreground="#18181B" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
            </StackPanel>
            <Border x:Name="LocalOnlyPill" Grid.Column="1" Background="#EDF8EF" BorderBrush="#142E7D32" BorderThickness="1" CornerRadius="12" Padding="9,5" VerticalAlignment="Center">
              <TextBlock x:Name="LocalOnlyText" Text="Local only" Foreground="#2E7D32" FontSize="10" FontWeight="SemiBold"/>
            </Border>
          </Grid>
          <TextBlock Grid.Row="1" x:Name="VersionText" Text="Gateway 0.9.0" Foreground="#A1A1AA" FontSize="10" Margin="0,10,0,0"/>
        </Grid>
      </Border>
      <Grid Grid.Row="5" Margin="0,12,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button Grid.Row="0" x:Name="PowerButton" Style="{StaticResource ActionButton}" Content="Restart Gateway"/>
        <Grid Grid.Row="1" Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Grid.Column="0" x:Name="RefreshButton" Style="{StaticResource MiniButton}" Content="Refresh"/>
          <Button Grid.Column="2" x:Name="SettingsButton" Style="{StaticResource MiniButton}" Content="Settings"/>
        </Grid>
      </Grid>
      </Grid>
      <Border x:Name="SettingsCard" Visibility="Collapsed" Opacity="0"
              Background="Transparent" BorderThickness="0" Padding="4">
        <Border.RenderTransform><TranslateTransform X="24"/></Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="SettingsBackButton" Style="{StaticResource MiniButton}" Content="&#x2039; Back" Padding="12,7"/>
            <TextBlock x:Name="SettingsTitle" Grid.Column="1" Text="Settings" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold" Foreground="#18181B"/>
            <Border Grid.Column="2" Width="64" Background="Transparent"/>
          </Grid>
          <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <ScrollViewer.Resources>
              <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Width" Value="6"/>
                <Setter Property="Opacity" Value="0.45"/>
              </Style>
            </ScrollViewer.Resources>
            <StackPanel>
              <Border x:Name="WorkspaceCard" Background="#F5F5F7" CornerRadius="18" Padding="12" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="WorkspaceLabel" Text="Workspace" Foreground="#18181B" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WorkspacePathText" Text="test-area" Foreground="#8E8E93" FontSize="10" Margin="0,3,10,0" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="WorkspaceChangeButton" Style="{StaticResource MiniButton}" Content="Change" Padding="12,7"/>
                </Grid>
              </Border>
              <Border x:Name="RecentCard" Visibility="Collapsed" Background="#F5F5F7" CornerRadius="18" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock x:Name="RecentLabel" Text="Recent Workspaces" Foreground="#8E8E93" FontSize="10" Margin="0,0,0,6"/>
                  <StackPanel>
                    <Button x:Name="RecentWorkspace1" Style="{StaticResource MiniButton}" Content="&#x2014;" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
                    <Button x:Name="RecentWorkspace2" Style="{StaticResource MiniButton}" Content="&#x2014;" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
                    <Button x:Name="RecentWorkspace3" Style="{StaticResource MiniButton}" Content="&#x2014;" HorizontalContentAlignment="Left"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border x:Name="AppearanceCard" Background="#F5F5F7" CornerRadius="18" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock x:Name="AppearanceLabel" Text="Appearance" Foreground="#18181B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7"/>
                  <Border x:Name="ThemeShell" Background="#E7E7EC" CornerRadius="13" Padding="3">
                    <Grid x:Name="ThemeSegmentsGrid">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border x:Name="ThemeIndicator" Grid.ColumnSpan="3" HorizontalAlignment="Left" Background="White" CornerRadius="10" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform x:Name="ThemeIndicatorTransform"/></Border.RenderTransform></Border>
                      <Button Grid.Column="0" x:Name="ThemeSystemButton" Style="{StaticResource SegmentButton}" FontSize="11" Content="System"/>
                      <Button Grid.Column="1" x:Name="ThemeLightButton" Style="{StaticResource SegmentButton}" FontSize="11" Content="Light"/>
                      <Button Grid.Column="2" x:Name="ThemeDarkButton" Style="{StaticResource SegmentButton}" FontSize="11" Content="Dark"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <Border x:Name="ShortcutCard" Background="#F5F5F7" CornerRadius="18" Padding="12" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="ShortcutLabel" Text="Shortcut" Foreground="#18181B" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ShortcutHint" Text="Global toggle" Foreground="#8E8E93" FontSize="10" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="ShortcutButton" Style="{StaticResource MiniButton}" Content="Ctrl + Alt + D" Padding="12,7"/>
                </Grid>
              </Border>
              <Border x:Name="StartupCard" Background="#F5F5F7" CornerRadius="18" Padding="12" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="StartupLabel" Text="Start with Windows" Foreground="#18181B" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StartupHint" Text="Launch quietly when you sign in" Foreground="#8E8E93" FontSize="10" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="StartupButton" Style="{StaticResource MiniButton}" Content="On" Padding="14,7"/>
                </Grid>
              </Border>
              <Border x:Name="TunnelSettingsCard" Background="#F5F5F7" CornerRadius="18" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock x:Name="TunnelSettingsLabel" Text="Tunnel" Foreground="#18181B" FontSize="11" FontWeight="SemiBold"/>
                      <TextBlock x:Name="TunnelConfigStatus" Text="Not configured" Foreground="#8E8E93" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="TunnelAutoButton" Style="{StaticResource MiniButton}" Content="Auto Off" Padding="12,7"/>
                  </Grid>
                  <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Tunnel ID" Foreground="#8E8E93" FontSize="9"/>
                    <TextBlock x:Name="TunnelIdValue" Text="Not configured" Foreground="#18181B" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="TunnelConfigureButton" Style="{StaticResource MiniButton}" Content="Configure"/>
                    <Button Grid.Column="2" x:Name="TunnelReconnectButton" Style="{StaticResource MiniButton}" Content="Reconnect"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border x:Name="UpdateCard" Background="#F5F5F7" CornerRadius="18" Padding="12" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="UpdateLabel" Text="Updates" Foreground="#18181B" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UpdateStatus" Text="Not checked" Foreground="#8E8E93" FontSize="10" Margin="0,2,10,0" TextWrapping="Wrap" MaxWidth="240"/>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="UpdateButton" Style="{StaticResource MiniButton}" Content="Check" Padding="12,7"/>
                </Grid>
              </Border>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="FolderButton" Style="{StaticResource MiniButton}" Content="Open Folder"/>
                <Button Grid.Column="2" x:Name="LogsButton" Style="{StaticResource MiniButton}" Content="Logs"/>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="ToastCard" Visibility="Collapsed" Opacity="0" Panel.ZIndex="80" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="18" Background="#FF2A2A2E" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="14" Padding="12,9">
        <Border.Effect><DropShadowEffect Color="#55000000" BlurRadius="22" ShadowDepth="5" Opacity="0.28"/></Border.Effect>
        <Border.RenderTransform><TranslateTransform x:Name="ToastTranslate" Y="8"/></Border.RenderTransform>
        <TextBlock x:Name="ToastText" Text="Saved" Foreground="White" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="290"/>
      </Border>
      <Grid x:Name="FirstRunOverlay" Visibility="Collapsed" Opacity="0" Panel.ZIndex="70" Margin="-16">
        <Border Background="#B3000000" CornerRadius="30"/>
        <Border x:Name="FirstRunModal" Width="350" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="26" Padding="22">
          <Border.Effect><DropShadowEffect Color="#72000000" BlurRadius="34" ShadowDepth="9" Opacity="0.38"/></Border.Effect>
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="DeskMCP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource UiTextSecondary}"/>
                <TextBlock x:Name="FirstRunTitle" Text="Choose your workspace" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}" Margin="0,4,0,0"/>
              </StackPanel>
              <Border Grid.Column="1" x:Name="FirstRunStepPill" Background="{DynamicResource UiAccentSoft}" BorderBrush="{DynamicResource UiInputBorder}" BorderThickness="1" CornerRadius="12" Padding="9,5" VerticalAlignment="Top">
                <TextBlock x:Name="FirstRunStepLabel" Text="1 / 3" Foreground="{DynamicResource UiAccentText}" FontSize="10" FontWeight="Bold"/>
              </Border>
            </Grid>
            <Grid x:Name="FirstRunWorkspaceStep">
              <StackPanel>
                <TextBlock Text="DeskMCP can only access files inside the workspace you choose. You can change it later in Settings." TextWrapping="Wrap" LineHeight="17" FontSize="11" Foreground="{DynamicResource UiTextSecondary}"/>
                <Border Background="{DynamicResource UiSurfaceMuted}" CornerRadius="16" Padding="13" Margin="0,14,0,10">
                  <StackPanel>
                    <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource UiTextMuted}"/>
                    <TextBlock x:Name="FirstRunWorkspacePath" Text="Loading&#x2026;" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}" Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="42"/>
                  </StackPanel>
                </Border>
                <Button x:Name="FirstRunChooseWorkspaceButton" Style="{StaticResource MiniButton}" Content="Choose Workspace&#x2026;"/>
                <Button x:Name="FirstRunWorkspaceNextButton" Style="{StaticResource ActionButton}" Content="Continue" Margin="0,12,0,0"/>
              </StackPanel>
            </Grid>
            <Grid x:Name="FirstRunTunnelStep" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Create a Tunnel in OpenAI Platform, then paste its Tunnel ID and Runtime API Key here." TextWrapping="Wrap" LineHeight="17" FontSize="11" Foreground="{DynamicResource UiTextSecondary}"/>
                <TextBlock Text="Tunnel ID" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}" Margin="0,14,0,0"/>
                <TextBox x:Name="FirstRunTunnelIdInput" Style="{StaticResource RoundedTextBox}" FontSize="12" Padding="11,9" Margin="0,6,0,10"/>
                <TextBlock Text="Runtime API Key" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}"/>
                <PasswordBox x:Name="FirstRunTunnelKeyInput" Style="{StaticResource RoundedPasswordBox}" FontSize="12" Padding="11,9" Margin="0,6,0,0"/>
                <TextBlock x:Name="FirstRunTunnelHint" Text="The key is stored with Windows DPAPI and is never written to settings.json." FontSize="9" TextWrapping="Wrap" LineHeight="14" Margin="0,7,0,0" Foreground="{DynamicResource UiTextMuted}"/>
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Grid.Column="0" x:Name="FirstRunTunnelSkipButton" Style="{StaticResource MiniButton}" Content="Skip for now"/>
                  <Button Grid.Column="2" x:Name="FirstRunTunnelSaveButton" Style="{StaticResource ActionButton}" Content="Save &amp; Continue"/>
                </Grid>
              </StackPanel>
            </Grid>
            <Grid x:Name="FirstRunPluginStep" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Finish in ChatGPT" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}"/>
                <TextBlock Text="Your local side is ready. Finish the connection in ChatGPT:" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,12" Foreground="{DynamicResource UiTextSecondary}"/>
                <Border Background="{DynamicResource UiSurfaceMuted}" CornerRadius="16" Padding="13">
                  <StackPanel>
                    <TextBlock Text="1   Plugins &#x2192; New plugin" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}"/>
                    <TextBlock Text="2   Name: DeskMCP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}" Margin="0,8,0,0"/>
                    <TextBlock Text="3   Connection: Tunnel &#x00B7; Auth: No auth" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="4   Select your Tunnel, check &#x2018;I understand and want to continue&#x2019;, then Scan tools" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border x:Name="FirstRunExpectedCard" Background="{DynamicResource UiAccentSoft}" CornerRadius="13" Padding="11,9" Margin="0,12,0,0">
                  <TextBlock Text="Expected result: 13 DeskMCP tools" Foreground="{DynamicResource UiAccentText}" FontSize="10" FontWeight="Bold"/>
                </Border>
                <Button x:Name="FirstRunFinishButton" Style="{StaticResource ActionButton}" Content="Finish Setup" Margin="0,16,0,0"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
      <Grid x:Name="TunnelSetupOverlay" Visibility="Collapsed" Opacity="0" Panel.ZIndex="60" Margin="-16">
        <Border Background="#66000000" CornerRadius="30"/>
        <Border x:Name="TunnelSetupModal" Width="330" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="24" Padding="20">
          <Border.Effect><DropShadowEffect Color="#66000000" BlurRadius="30" ShadowDepth="8" Opacity="0.35"/></Border.Effect>
          <Border.RenderTransform><ScaleTransform x:Name="TunnelSetupModalScale" ScaleX="0.94" ScaleY="0.94"/></Border.RenderTransform>
          <StackPanel>
            <TextBlock x:Name="TunnelSetupTitle" Text="Connect Tunnel" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}"/>
            <TextBlock x:Name="TunnelSetupHint" Text="Paste the Tunnel ID and Runtime API Key from OpenAI Platform." FontSize="10" TextWrapping="Wrap" LineHeight="15" Margin="0,7,0,14" Foreground="{DynamicResource UiTextSecondary}"/>
            <TextBlock x:Name="TunnelIdFieldLabel" Text="Tunnel ID" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}"/>
            <TextBox x:Name="TunnelIdInput" Style="{StaticResource RoundedTextBox}" FontSize="12" Padding="11,9" Margin="0,6,0,12"/>
            <TextBlock x:Name="TunnelKeyFieldLabel" Text="Runtime API Key" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimary}"/>
            <PasswordBox x:Name="TunnelRuntimeKeyInput" Style="{StaticResource RoundedPasswordBox}" FontSize="12" Padding="11,9" Margin="0,6,0,0"/>
            <TextBlock x:Name="TunnelRuntimeKeyHint" Text="Protected with Windows DPAPI. Leave blank to keep the existing key." FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource UiTextMuted}"/>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button Grid.Column="0" x:Name="TunnelSetupCancelButton" Style="{StaticResource MiniButton}" Content="Cancel"/>
              <Button Grid.Column="2" x:Name="TunnelSetupSaveButton" Style="{StaticResource ActionButton}" Content="Save &amp; Connect"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
      <Grid x:Name="FullControlOverlay" Visibility="Collapsed" Opacity="0" Panel.ZIndex="50" Margin="-16">
        <Border Background="#66000000" CornerRadius="30"/>
        <Border x:Name="FullControlModal" Width="330" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="24" Padding="20">
          <Border.Effect><DropShadowEffect Color="#66000000" BlurRadius="30" ShadowDepth="8" Opacity="0.35"/></Border.Effect>
          <Border.RenderTransform><ScaleTransform x:Name="FullControlModalScale" ScaleX="0.94" ScaleY="0.94"/></Border.RenderTransform>
          <StackPanel>
            <Border x:Name="FullControlDangerPill" Background="{DynamicResource UiDangerSoft}" CornerRadius="10" Padding="9,4" HorizontalAlignment="Left">
              <TextBlock Text="FULL CONTROL" Foreground="{DynamicResource UiDangerText}" FontSize="10" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Enable Full Control?" Foreground="{DynamicResource UiTextPrimary}" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,0"/>
            <TextBlock Text="Gateway-owned terminal sessions will run with your current Windows user permissions."
                       Foreground="{DynamicResource UiTextSecondary}" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,0"/>
            <Border x:Name="FullControlNote" Background="{DynamicResource UiSurfaceMuted}" BorderBrush="{DynamicResource UiInputBorder}" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,13,0,0">
              <TextBlock Text="Filesystem tools stay inside the selected Workspace. Terminal sessions are not filesystem-sandboxed by that Workspace boundary."
                         Foreground="{DynamicResource UiTextSecondary}" FontSize="10" TextWrapping="Wrap" LineHeight="15"/>
            </Border>
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button Grid.Column="0" x:Name="FullControlCancelButton" Style="{StaticResource MiniButton}" Content="Cancel"/>
              <Button Grid.Column="2" x:Name="FullControlEnableButton" Style="{StaticResource ActionButton}" Content="Enable" Background="#FFFF453A"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
