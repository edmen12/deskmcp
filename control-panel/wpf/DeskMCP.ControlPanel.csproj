<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DeskMCP</AssemblyName>
    <RootNamespace>DeskMCP.ControlPanel</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\..\assets\brand\DeskMCP.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Panel.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="..\..\assets\brand\deskmcp-mark-64.png" Link="brand\deskmcp-mark-64.png"/>
    <Content Include="..\..\assets\brand\DeskMCP.ico" Link="brand\DeskMCP.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
